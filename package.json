{
    "name": "kori",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
        "dev:client": "vite",
        "dev:server": "tsx --watch server/index.ts",
        "dev:all": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "start": "node --loader tsx server/index.ts"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "better-auth": "^1.7.4",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "lucide": "^1.42.0",
        "lucide-react": "^1.42.0",
        "mongodb": "^7.6.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hot-toast": "^2.6.0",
        "react-router-dom": "^7.18.3",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.4",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.1.0",
        "concurrently": "^10.0.5",
        "eslint": "^10.9.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "globals": "^17.11.0",
        "tsx": "^4.23.13",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.2"
    }
}
